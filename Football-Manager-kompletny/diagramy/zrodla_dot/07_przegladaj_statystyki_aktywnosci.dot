digraph G { graph [rankdir=TB,bgcolor="white",pad=.25, nodesep=.3,ranksep=.35,label="Diagram aktywności — Przeglądaj statystyki i ranking",labelloc=t,fontsize=18,fontname="Arial"]; node [fontname="Arial",fontsize=10]; edge [arrowsize=.7]; start [shape=circle,label="",width=.18,height=.18,style=filled,fillcolor="#202b22"]; n1 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Otwórz dashboard lub ranking"]; n2 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Wyślij GET /api/stats lub GET /api/players"]; n3 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Oblicz / posortuj statystyki"]; n4 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Wyświetl wyniki"]; end [shape=doublecircle,label="",width=.2,height=.2];start -> n1; n1 -> n2; n2 -> n3; n3 -> n4; n4 -> end; }