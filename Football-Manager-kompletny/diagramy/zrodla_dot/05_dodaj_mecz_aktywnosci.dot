digraph G { graph [rankdir=TB,bgcolor="white",pad=.25, nodesep=.3,ranksep=.35,label="Diagram aktywności — Dodaj mecz",labelloc=t,fontsize=18,fontname="Arial"]; node [fontname="Arial",fontsize=10]; edge [arrowsize=.7]; start [shape=circle,label="",width=.18,height=.18,style=filled,fillcolor="#202b22"]; n1 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Otwórz formularz meczu"]; n2 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Wprowadź przeciwnika i datę"]; n3 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Wyślij POST /api/matches"]; n4 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Zweryfikuj dane"]; n5 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Zapisz mecz w SQLite"]; n6 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Odśwież terminarz"]; end [shape=doublecircle,label="",width=.2,height=.2];start -> n1; n1 -> n2; n2 -> n3; n3 -> n4; n4 -> n5; n5 -> n6; n6 -> end; }