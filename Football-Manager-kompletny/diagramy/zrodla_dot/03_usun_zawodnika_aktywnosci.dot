digraph G { graph [rankdir=TB,bgcolor="white",pad=.25, nodesep=.3,ranksep=.35,label="Diagram aktywności — Usuń zawodnika",labelloc=t,fontsize=18,fontname="Arial"]; node [fontname="Arial",fontsize=10]; edge [arrowsize=.7]; start [shape=circle,label="",width=.18,height=.18,style=filled,fillcolor="#202b22"]; n1 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Kliknij Usuń"]; n2 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Potwierdź usunięcie"]; n3 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Wyślij DELETE /api/players/id"]; n4 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Usuń rekord z SQLite"]; n5 [shape=box,style="rounded,filled",fillcolor="#eef5e9",label="Odśwież listę"]; end [shape=doublecircle,label="",width=.2,height=.2];start -> n1; n1 -> n2; n2 -> n3; n3 -> n4; n4 -> n5; n5 -> end; }